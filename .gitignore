# EL-FAITH Microfinance - Git Ignore Rules

# Exclude live/generated database backup dumps (keep security wrappers)
backups/*.sql

# Exclude uploaded runtime company logos (keep .htaccess / index.php)
assets/uploads/company_logo_*

# Environment & Secrets
.env
*.local.php
config/database.prod.php

# Logs & Temporary Files
*.log
*.tmp
*.temp
*.bak

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

