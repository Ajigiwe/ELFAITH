# =====================================================================
# EL-FAITH MICROFINANCE - Shared cPanel / Apache Production Rules
# =====================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to internal directories & hidden dotfiles (.git, .env, etc.)
    RewriteRule ^(\.git|config|database|includes)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Force HTTPS on live domains (skips localhost/127.0.0.1 and reverse-proxy HTTPS)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Block direct access to sensitive file types & project metadata
<FilesMatch "(\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|md)|^\.git.*|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security & PWA Cache-Control Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

